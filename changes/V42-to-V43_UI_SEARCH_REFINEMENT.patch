+                out.add(new LyricSearchResult(enrichWithKnownVariant(hit.song), hit.snippet));
+            }
+        }
+        out.sort((a, b) -> Integer.compare(lyricMatchScore(keyword, b), lyricMatchScore(keyword, a)));
+        return out;
+    }
