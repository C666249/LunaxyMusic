+    private int[] parseGradientPair(String raw) {
+        if (raw == null) return null;
+        String[] parts = raw.trim().split("[,，\\s]+", -1);
+        if (parts.length < 2) return null;
+        try {
+            int first = Color.parseColor(parts[0].startsWith("#") ? parts[0] : "#" + parts[0]);
+            int second = Color.parseColor(parts[1].startsWith("#") ? parts[1] : "#" + parts[1]);
+            return new int[]{first, second};
+        } catch (Exception ignored) { return null; }
+    }
