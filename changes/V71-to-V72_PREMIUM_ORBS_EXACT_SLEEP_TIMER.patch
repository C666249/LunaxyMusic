+package com.xingyu.music.ui;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.RadialGradient;
+import android.graphics.Shader;
+import android.view.View;
+import android.view.animation.AccelerateDecelerateInterpolator;
+
+/**
+ * Presentation-only platform identity orb.
+ *
+ * A tiny layered sphere is used instead of a flat dot: soft halo, shaded body,
+ * glass edge and a one-shot specular shimmer when the row appears. It carries
+ * no source-selection logic and never reads or writes playback state.
+ */
+public final class PlatformOrbView extends View {
+    private final int baseColor;
+    private final long shimmerDelayMs;
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint stroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private RadialGradient bodyShader;
+    private ValueAnimator shimmerAnimator;
+    private float shimmer;
+    private float cx;
+    private float cy;
+    private float bodyRadius;
+
+    public PlatformOrbView(Context context, int baseColor, long shimmerDelayMs) {
+        super(context);
+        this.baseColor = baseColor;
+        this.shimmerDelayMs = Math.max(0L, shimmerDelayMs);
+        stroke.setStyle(Paint.Style.STROKE);
+        stroke.setStrokeWidth(Ui.dp(context, .55f));
+        setClickable(false);
+        setFocusable(false);
+    }
+
+    @Override protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+        float min = Math.min(w, h);
+        cx = w * .5f;
+        cy = h * .5f;
+        bodyRadius = min * .31f;
+        float lightX = cx - bodyRadius * .34f;
+        float lightY = cy - bodyRadius * .40f;
+        int bright = Ui.mix(baseColor, Color.WHITE, .58f);
+        int mid = Ui.mix(baseColor, Color.WHITE, .16f);
+        int edge = Ui.mix(baseColor, Color.BLACK, .38f);
+        bodyShader = new RadialGradient(
+                lightX, lightY, bodyRadius * 1.56f,
+                new int[]{bright, mid, baseColor, edge},
+                new float[]{0f, .23f, .62f, 1f},
+                Shader.TileMode.CLAMP);
+    }
+
+    @Override protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        if (bodyRadius <= 0f) return;
+
+        // Halo stays inside the view bounds so hardware rendering remains cheap and predictable.
+        paint.setShader(null);
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(withAlpha(baseColor, 22 + Math.round(26f * shimmer)));
+        canvas.drawCircle(cx, cy, bodyRadius * 1.55f, paint);
+        paint.setColor(withAlpha(baseColor, 36 + Math.round(24f * shimmer)));
+        canvas.drawCircle(cx, cy, bodyRadius * 1.23f, paint);
+
+        paint.setShader(bodyShader);
+        canvas.drawCircle(cx, cy, bodyRadius, paint);
+        paint.setShader(null);
+
+        // Fine glass rim gives the tiny sphere a crisp, premium edge instead of a flat sticker look.
+        stroke.setColor(Color.argb(88, 255, 255, 255));
+        canvas.drawCircle(cx, cy, bodyRadius - stroke.getStrokeWidth() * .5f, stroke);
+        stroke.setColor(Color.argb(48, 0, 0, 0));
+        canvas.drawArc(cx - bodyRadius, cy - bodyRadius, cx + bodyRadius, cy + bodyRadius,
+                28f, 150f, false, stroke);
+
+        // Permanent top-left specular point.
+        paint.setColor(Color.argb(185, 255, 255, 255));
+        canvas.drawCircle(cx - bodyRadius * .34f, cy - bodyRadius * .38f,
+                Math.max(1f, bodyRadius * .13f), paint);
+
+        // One-shot moving highlight. The stagger is supplied by the caller so rows do not flash in sync.
+        if (shimmer > 0f && shimmer < 1f) {
+            float wave = (float) Math.sin(Math.PI * shimmer);
+            float sx = cx - bodyRadius * .48f + bodyRadius * .96f * shimmer;
+            float sy = cy - bodyRadius * .46f + bodyRadius * .18f * shimmer;
+            RadialGradient glint = new RadialGradient(
+                    sx, sy, Math.max(1f, bodyRadius * .54f),
+                    new int[]{Color.argb(Math.round(150f * wave), 255, 255, 255), Color.TRANSPARENT},
+                    new float[]{0f, 1f}, Shader.TileMode.CLAMP);
+            paint.setShader(glint);
+            canvas.drawCircle(cx, cy, bodyRadius, paint);
+            paint.setShader(null);
+        }
+    }
+
+    @Override protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        startShimmerOnce();
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        if (shimmerAnimator != null) shimmerAnimator.cancel();
+        shimmerAnimator = null;
+        super.onDetachedFromWindow();
+    }
+
+    private void startShimmerOnce() {
+        if (shimmerAnimator != null) return;
+        shimmerAnimator = ValueAnimator.ofFloat(0f, 1f);
+        shimmerAnimator.setStartDelay(shimmerDelayMs);
+        shimmerAnimator.setDuration(820L);
+        shimmerAnimator.setInterpolator(new AccelerateDecelerateInterpolator());
+        shimmerAnimator.addUpdateListener(a -> {
+            shimmer = (float) a.getAnimatedValue();
+            invalidate();
+        });
+        shimmerAnimator.start();
+    }
+
+    private static int withAlpha(int color, int alpha) {
+        return Color.argb(Math.max(0, Math.min(255, alpha)),
+                Color.red(color), Color.green(color), Color.blue(color));
+    }
+}
