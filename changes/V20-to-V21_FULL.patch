+    /**
+     * Weather + daypart station. It only searches song metadata and local taste data; it never
+     * requests playback URLs. Results are cached by date + coarse weather bucket + daypart.
+     */
+    public List<Song> weatherRadio(List<Song> favorites, List<ImportedPlaylist> playlists,
+                                   List<Song> history, WeatherMoodProvider.WeatherSnapshot weather,
+                                   int limit) {
+        int max = Math.max(1, Math.min(limit, 30));
+        if (weather == null) return privateRadio(favorites, playlists, history, max);
+        String cacheKey = dayKey() + "|" + weather.cacheKey();
+        if (cacheKey.equals(prefs.getString("weather_key", ""))) {
+            List<Song> cached = decode(prefs.getString("weather_songs", "[]"));
+            if (!cached.isEmpty()) return trim(cached, max);
+        }
+
+        List<String> seeds = topArtists(favorites, playlists, history, 2);
+        LinkedHashMap<String,Song> outMap = new LinkedHashMap<>();
+        String moodWord = weather.discoveryWord();
+        // Keep the user's artists as the strongest constraint, then let the weather/daypart
+        // keyword nudge discovery toward a matching atmosphere. This is metadata search only.
+        for (String artist : seeds) {
+            String query = (artist + " " + moodWord).trim();
+            List<Song> wy = new ArrayList<>();
+            List<Song> tx = new ArrayList<>();
+            try { wy = netease.search(query, 16); } catch (Exception ignored) { }
+            try { tx = qq.search(query, 16); } catch (Exception ignored) { }
+            for (Song s : SearchRanker.mergeAndRank(query, wy, tx, 22)) {
+                if (s == null || !artistMatches(s.artist, artist)) continue;
+                outMap.putIfAbsent(s.key(), s);
+            }
+        }
+
+        // Always anchor the station in the user's own library. A stable weather/daypart seed makes
+        // the order feel different between rain/night/morning without requiring a paid model/API.
+        List<Song> local = privateRadio(favorites, playlists, history, Math.max(max, 30));
+        Collections.shuffle(local, new Random(cacheKey.hashCode() * 2654435761L));
+        for (Song s : local) {
+            if (s != null) outMap.putIfAbsent(s.key(), s);
+            if (outMap.size() >= max) break;
+        }
+
+        List<Song> out = trim(new ArrayList<>(outMap.values()), max);
+        if (!out.isEmpty()) {
+            prefs.edit().putString("weather_key", cacheKey).putString("weather_songs", encode(out)).apply();
+        }
+        return out;
+    }
