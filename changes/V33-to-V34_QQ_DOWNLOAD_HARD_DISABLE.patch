@@ -0,0 +1,30 @@
+package com.xingyu.music.data;
+
+import com.xingyu.music.model.Song;
+import com.xingyu.music.model.SourceVariant;
+
+/**
+ * V34 hard download policy.
+ *
+ * Safety invariant: if a canonical song contains ANY QQ/tx provider identity,
+ * download is forbidden before cache lookup, background scheduling, CDN access,
+ * Huibq/QDY resolution, or any other network work.
+ *
+ * This intentionally also blocks merged "QQ · 网易" tracks. Playback is not
+ * affected; the rule applies only to the optional offline download feature.
+ */
+public final class DownloadPolicy {
+    public static final String QQ_DOWNLOAD_DISABLED = "QQ 来源已禁用下载，仅支持在线播放";
+
+    private DownloadPolicy() { }
+
+    /** True when this canonical track contains any QQ (tx) identity. */
+    public static boolean blocksQqDownload(Song song) {
+        if (song == null) return false;
+        if ("tx".equals(song.source) || "tx".equals(song.fallbackSource)) return true;
+        for (SourceVariant variant : song.variants()) {
+            if (variant != null && "tx".equals(variant.source)) return true;
+        }
+        return false;
+    }
+}
