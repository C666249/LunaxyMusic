+    private void resetFlowStar(FlowStar s, boolean randomDepth) {
+        float depth = randomDepth
+                ? lerp(3.2f, FLOW_FAR_DEPTH, flowRandom.nextFloat())
+                : lerp(FLOW_FAR_DEPTH * .90f, FLOW_FAR_DEPTH, flowRandom.nextFloat());
