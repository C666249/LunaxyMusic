-        if (DownloadPolicy.blocksQqDownload(song)) {
-            throw new Exception(DownloadPolicy.QQ_DOWNLOAD_DISABLED);
-        }
-        if (!DownloadPolicy.allowsNeteaseDownload(song)) {
-            throw new Exception(DownloadPolicy.NETEASE_ONLY);
