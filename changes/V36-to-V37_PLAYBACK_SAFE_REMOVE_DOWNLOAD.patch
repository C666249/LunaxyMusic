-        // No cache lookup, no URL access, no CDN request, no resolver call.
-        if (DownloadPolicy.blocksQqDownload(song)) {
-            fail(listener, DownloadPolicy.QQ_DOWNLOAD_DISABLED);
-            return;
-        }
-        if (!DownloadPolicy.allowsNeteaseDownload(song)) {
-            fail(listener, DownloadPolicy.NETEASE_ONLY);
-            return;
-        }
-        String key = song.key();
-        if (!running.add(key)) { fail(listener, "这首歌正在下载"); return; }
-        worker.submit(() -> {
-            try {
-                DownloadedTrack track = tryDownload(song);
-                store.put(track);
-                complete(listener, track);
-            } catch (Exception e) {
-                fail(listener, friendlyFailure(song, e));
-            } finally {
-                running.remove(key);
-            }
-        });
-    }
-
