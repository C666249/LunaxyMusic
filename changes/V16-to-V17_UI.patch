+        lyricScrollSettleRunnable = () -> {
+            if (lyricManualGesture) return;
+            updateLyricSeekCandidate();
+            setManualLyricSelection(lyricSeekCandidate);
+            lyricSeekMode = false;
+            showLyricSeekGuide(false);
