+    private static boolean qualityPresent(JSONObject o, String key) {
+        if (o == null || !o.has(key) || o.isNull(key)) return false;
+        JSONObject q = o.optJSONObject(key);
+        if (q == null) return true;
+        return q.optLong("size", q.optLong("br", 1L)) > 0L;
+    }
