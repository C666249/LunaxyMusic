+    private boolean shouldSearchLyrics(String keyword, int normalResultCount) {
+        String normalized = normalizeSuggestion(keyword);
+        int len = normalized.length();
+        if (len >= 10) return true;
+        if (len >= 5 && containsSentenceCue(keyword)) return true;
+        return len >= 4 && normalResultCount <= 3;
+    }
+
+    private boolean containsSentenceCue(String text) {
+        if (text == null) return false;
+        String q = text.trim();
+        if (q.contains(" ") || q.contains("，") || q.contains(",") || q.contains("。")) return true;
+        String[] cues = {"我", "你", "他", "她", "我们", "如果", "因为", "怎么", "为何", "曾经", "还是", "已经", "没有", "不能", "想起", "记得", "爱你"};
+        int hits = 0;
+        for (String cue : cues) if (q.contains(cue) && ++hits >= 2) return true;
+        return false;
+    }
+
+    private List<LyricSearchResult> findLocalLyricMatches(String keyword, int max, List<Song> currentWy, List<Song> currentTx) {
+        ArrayList<LyricSearchResult> out = new ArrayList<>();
+        if (lyricCache == null || max <= 0) return out;
+        String needle = normalizeSuggestion(keyword);
+        if (needle.length() < 3) return out;
+        LinkedHashMap<String, Song> candidates = new LinkedHashMap<>();
+        for (Song song : favorites) if (song != null) candidates.put(song.key(), song);
+        for (ImportedPlaylist p : playlists) if (p != null && p.songs != null)
+            for (Song song : p.songs) if (song != null) candidates.put(song.key(), song);
+        for (Song song : history) if (song != null) candidates.put(song.key(), song);
+        if (currentWy != null) for (Song song : currentWy) if (song != null) candidates.put(song.key(), song);
+        if (currentTx != null) for (Song song : currentTx) if (song != null) candidates.put(song.key(), song);
+        for (Song song : candidates.values()) {
+            if (out.size() >= max) break;
+            String lrc = lyricCache.get(song);
+            String snippet = matchingLyricLine(lrc, needle);
+            if (!snippet.isEmpty()) out.add(new LyricSearchResult(song, snippet));
+        }
+        return out;
+    }
+
+    private String matchingLyricLine(String lrc, String normalizedNeedle) {
+        if (lrc == null || lrc.trim().isEmpty() || normalizedNeedle == null || normalizedNeedle.isEmpty()) return "";
+        String[] lines = lrc.split("\\r?\\n");
+        for (String raw : lines) {
+            String line = raw == null ? "" : raw.replaceAll("\\[[^\\]]*\\]", " ")
+                    .replaceAll("<[^>]+>", " ").replaceAll("\\s+", " ").trim();
+            if (line.length() < 2 || !normalizeSuggestion(line).contains(normalizedNeedle)) continue;
+            return line.length() <= 54 ? line : line.substring(0, 54) + "…";
+        }
+        return "";
+    }
+
+    private List<LyricSearchResult> mergeLyricHits(String keyword, List<LyricSearchResult> local,
+                                                    List<NeteaseLyricSearchApi.Hit> remote, int max) {
+        LinkedHashMap<String, LyricSearchResult> out = new LinkedHashMap<>();
+        if (local != null) for (LyricSearchResult hit : local) {
+            if (hit != null && hit.song != null) out.put(hit.song.key(), hit);
+        }
+        if (remote != null) for (NeteaseLyricSearchApi.Hit hit : remote) {
+            if (hit == null || hit.song == null || out.size() >= max) continue;
+            boolean metadataOnly = metadataContainsQuery(hit.song, keyword) && (hit.snippet == null || hit.snippet.trim().isEmpty());
+            if (metadataOnly) continue; // don't duplicate ordinary title/artist matches as "lyrics"
+            Song song = enrichWithKnownVariant(hit.song);
+            String snippet = hit.snippet == null || hit.snippet.trim().isEmpty() ? "包含你搜索的歌词片段" : hit.snippet;
+            out.putIfAbsent(song.key(), new LyricSearchResult(song, snippet));
+        }
+        ArrayList<LyricSearchResult> list = new ArrayList<>(out.values());
+        return list.size() <= max ? list : new ArrayList<>(list.subList(0, max));
+    }
+
+    private Song enrichWithKnownVariant(Song incoming) {
+        if (incoming == null) return null;
+        String identity = normalizeSuggestion(incoming.title) + "|" + normalizeSuggestion(incoming.artist);
+        LinkedHashMap<String, Song> known = new LinkedHashMap<>();
+        for (Song song : favorites) if (song != null) known.put(song.key(), song);
+        for (ImportedPlaylist p : playlists) if (p != null && p.songs != null)
+            for (Song song : p.songs) if (song != null) known.put(song.key(), song);
+        for (Song song : history) if (song != null) known.put(song.key(), song);
+        for (Song song : known.values()) {
+            String other = normalizeSuggestion(song.title) + "|" + normalizeSuggestion(song.artist);
+            if (identity.equals(other)) return song.withVariant(incoming);
+        }
+        return incoming;
+    }
+
+    private boolean metadataContainsQuery(Song song, String keyword) {
+        String needle = normalizeSuggestion(keyword);
+        if (song == null || needle.isEmpty()) return false;
+        return normalizeSuggestion(song.title).contains(needle) || normalizeSuggestion(song.artist).contains(needle);
+    }
