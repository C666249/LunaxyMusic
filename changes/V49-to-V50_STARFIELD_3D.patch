+package com.xingyu.music.ui;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.hardware.Sensor;
+import android.hardware.SensorEvent;
+import android.hardware.SensorEventListener;
+import android.hardware.SensorManager;
+import android.os.SystemClock;
+import android.view.View;
+
+import java.util.Random;
+
+/**
+ * Lunaxy V50 immersive star-volume renderer for the now-playing page.
+ *
+ * Unlike the legacy StarfieldView's small screen-space tilt parallax, this view
+ * creates one deterministic 360-degree star volume around the listener and treats
+ * the phone as a camera/window into that volume.  TYPE_GAME_ROTATION_VECTOR drives
+ * a full 3D quaternion camera, so yaw/pitch/roll can reveal completely new star
+ * regions and a physical 360-degree turn returns to the original sky.
+ *
+ * Rendering deliberately stays inside an ordinary non-clickable hardware Canvas
+ * View instead of a SurfaceView.  That keeps the existing lyric gestures, player
+ * controls, window insets and animation stacking untouched while still using the
+ * GPU-backed Android display list for the actual point/glow drawing.
+ */
+public final class Starfield3DView extends View implements SensorEventListener {
+    private static final int LAYER_FAR = 0;
+    private static final int LAYER_MID = 1;
+    private static final int LAYER_NEAR = 2;
+
+    // Full sphere counts.  Only the current camera frustum is drawn, so roughly
+    // 7-10% of these points are visible in portrait at once.
+    private static final int FAR_COUNT = 1500;
+    private static final int MID_COUNT = 650;
+    private static final int NEAR_COUNT = 250;
+    private static final int STAR_COUNT = FAR_COUNT + MID_COUNT + NEAR_COUNT;
+
+    private static final float BASE_VERTICAL_FOV_DEG = 74f;
+    private static final float NEAR_PLANE = .28f;
+    private static final long UNIVERSE_SEED = 0x4C554E4158595032L; // "LUNAXYP2"
+
+    private static final class Star {
+        float x, y, z;
+        float distance;
+        float worldRadius;
+        float brightness;
+        float phase;
+        float twinkleSpeed;
+        float tintWeight;
+        int layer;
+        boolean flare;
+        boolean previousVisible;
+        float previousX, previousY;
+    }
+
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Star[] stars = new Star[STAR_COUNT];
+    private final Random random = new Random(UNIVERSE_SEED);
+    private final SensorManager sensorManager;
+    private final Sensor rotationSensor;
+    private final Sensor linearAccelerationSensor;
+
+    // Android/SensorManager quaternion layout after getQuaternionFromVector: [w,x,y,z].
+    private final float[] baselineSensorQ = new float[]{1f, 0f, 0f, 0f};
+    private final float[] sensorQ = new float[]{1f, 0f, 0f, 0f};
+    private final float[] targetCameraQ = new float[]{1f, 0f, 0f, 0f};
+    private final float[] cameraQ = new float[]{1f, 0f, 0f, 0f};
+    private final float[] nextCameraQ = new float[4];
+    private final float[] lastSensorQ = new float[]{1f, 0f, 0f, 0f};
+    private final float[] rotated = new float[3];
+
+    private boolean running;
+    private boolean rotationRegistered;
+    private boolean linearRegistered;
+    private boolean hasBaseline;
+    private boolean hasLastSensorQ;
+    private long lastFrameMs;
+    private long lastRotationSensorNs;
+
+    private float angularSpeed;
+    private float targetShiftX, targetShiftY, targetShiftZ;
+    private float cameraShiftX, cameraShiftY, cameraShiftZ;
+    private int accent = Color.rgb(183, 165, 255);
+    private AudioLevelProvider audioLevels;
+    private float visualEnergy;
+    private float visualBeat;
+
+    public Starfield3DView(Context context) {
+        super(context);
+        setBackgroundColor(Color.BLACK);
+        setLayerType(View.LAYER_TYPE_HARDWARE, null);
+        setClickable(false);
+        setFocusable(false);
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+        createUniverse();
+
+        sensorManager = (SensorManager) context.getSystemService(Context.SENSOR_SERVICE);
+        Sensor rotation = sensorManager == null ? null
+                : sensorManager.getDefaultSensor(Sensor.TYPE_GAME_ROTATION_VECTOR);
+        if (rotation == null && sensorManager != null)
+            rotation = sensorManager.getDefaultSensor(Sensor.TYPE_ROTATION_VECTOR);
+        rotationSensor = rotation;
+        linearAccelerationSensor = sensorManager == null ? null
+                : sensorManager.getDefaultSensor(Sensor.TYPE_LINEAR_ACCELERATION);
+    }
+
+    public void setAccentColor(int color) {
+        accent = color;
+        invalidate();
+    }
+
+    public void setAudioLevelProvider(AudioLevelProvider provider) {
+        audioLevels = provider;
+        if (running) postInvalidateOnAnimation();
+    }
+
+    /** True when the device exposes a rotation-vector sensor for physical camera tracking. */
+    public boolean hasRotationTracking() {
+        return rotationSensor != null;
+    }
+
+    private void createUniverse() {
+        int index = 0;
+        for (int i = 0; i < FAR_COUNT; i++) stars[index++] = createStar(LAYER_FAR);
+        for (int i = 0; i < MID_COUNT; i++) stars[index++] = createStar(LAYER_MID);
+        for (int i = 0; i < NEAR_COUNT; i++) stars[index++] = createStar(LAYER_NEAR);
+    }
+
+    private Star createStar(int layer) {
+        Star s = new Star();
+        // Uniform direction over the full sphere.  The universe is fixed by seed;
+        // switching songs changes color only, never the star locations.
+        float u = random.nextFloat() * 2f - 1f;
+        float theta = random.nextFloat() * (float) (Math.PI * 2.0);
+        float ring = (float) Math.sqrt(Math.max(0f, 1f - u * u));
+        float dx = ring * (float) Math.cos(theta);
+        float dy = u;
+        float dz = ring * (float) Math.sin(theta);
+
+        s.layer = layer;
+        if (layer == LAYER_FAR) {
+            s.distance = lerp(52f, 94f, random.nextFloat());
+            s.worldRadius = lerp(.105f, .255f, random.nextFloat());
+            s.brightness = lerp(.34f, .76f, random.nextFloat());
+            s.tintWeight = lerp(.04f, .13f, random.nextFloat());
+            s.flare = random.nextFloat() < .005f;
+        } else if (layer == LAYER_MID) {
+            s.distance = lerp(22f, 44f, random.nextFloat());
+            s.worldRadius = lerp(.055f, .145f, random.nextFloat());
+            s.brightness = lerp(.48f, .92f, random.nextFloat());
+            s.tintWeight = lerp(.08f, .22f, random.nextFloat());
+            s.flare = random.nextFloat() < .012f;
+        } else {
+            s.distance = lerp(7.5f, 17f, random.nextFloat());
+            s.worldRadius = lerp(.022f, .062f, random.nextFloat());
+            s.brightness = lerp(.58f, 1f, random.nextFloat());
+            s.tintWeight = lerp(.12f, .34f, random.nextFloat());
+            s.flare = random.nextFloat() < .035f;
+        }
+
+        s.x = dx * s.distance;
+        s.y = dy * s.distance;
+        s.z = dz * s.distance;
+        s.phase = random.nextFloat() * (float) (Math.PI * 2.0);
+        s.twinkleSpeed = lerp(.38f, 1.15f, random.nextFloat());
+        return s;
+    }
+
+    @Override protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        startMotion();
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        stopMotion();
+        super.onDetachedFromWindow();
+    }
+
+    @Override protected void onWindowVisibilityChanged(int visibility) {
+        super.onWindowVisibilityChanged(visibility);
+        if (!isAttachedToWindow()) return;
+        if (visibility == VISIBLE) startMotion();
+        else stopMotion();
+    }
+
+    @Override protected void onVisibilityChanged(View changedView, int visibility) {
+        super.onVisibilityChanged(changedView, visibility);
+        if (!isAttachedToWindow()) return;
+        // Ancestor visibility matters too: when the now-playing overlay is GONE, stop
+        // sensors/rendering even though this child's own visibility flag is still VISIBLE.
+        if (visibility == VISIBLE) startMotion();
+        else stopMotion();
+    }
+
+    private void startMotion() {
+        if (!running) {
+            running = true;
+            hasBaseline = false;
+            hasLastSensorQ = false;
+            lastRotationSensorNs = 0L;
+            angularSpeed = 0f;
+            targetShiftX = targetShiftY = targetShiftZ = 0f;
+            cameraShiftX = cameraShiftY = cameraShiftZ = 0f;
+            Starfield3DMath.identity(targetCameraQ);
+            Starfield3DMath.identity(cameraQ);
+            clearTrails();
+            lastFrameMs = SystemClock.uptimeMillis();
+            postInvalidateOnAnimation();
+        }
+        if (!rotationRegistered && sensorManager != null && rotationSensor != null) {
+            rotationRegistered = sensorManager.registerListener(
+                    this, rotationSensor, SensorManager.SENSOR_DELAY_GAME);
+        }
+        if (!linearRegistered && sensorManager != null && linearAccelerationSensor != null) {
+            linearRegistered = sensorManager.registerListener(
+                    this, linearAccelerationSensor, SensorManager.SENSOR_DELAY_GAME);
+        }
+    }
+
+    private void stopMotion() {
+        running = false;
+        if (sensorManager != null) {
+            if (rotationRegistered) sensorManager.unregisterListener(this, rotationSensor);
+            if (linearRegistered) sensorManager.unregisterListener(this, linearAccelerationSensor);
+        }
+        rotationRegistered = false;
+        linearRegistered = false;
+        hasBaseline = false;
+        clearTrails();
+    }
+
+    private void clearTrails() {
+        for (Star s : stars) if (s != null) s.previousVisible = false;
+    }
+
+    @Override protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        float width = getWidth();
+        float height = getHeight();
+        if (width <= 0f || height <= 0f) return;
+        canvas.drawColor(Color.BLACK);
+
+        long nowMs = SystemClock.uptimeMillis();
+        float dt = Math.min(.05f, Math.max(.001f, (nowMs - lastFrameMs) / 1000f));
+        lastFrameMs = nowMs;
+        float time = nowMs / 1000f;
+
+        updateAudio(dt);
+
+        // Responsive but damped quaternion camera: large deliberate turns follow quickly,
+        // tiny hand jitter is filtered before it reaches the stars.
+        float orientationBlend = 1f - (float) Math.exp(-11.0f * dt);
+        Starfield3DMath.slerp(cameraQ, targetCameraQ, orientationBlend, nextCameraQ);
+        Starfield3DMath.copy(nextCameraQ, cameraQ);
+
+        // Linear-acceleration input is intentionally tiny and heavily damped.  It does
+        // not pretend to be AR/6DoF tracking; it only gives nearby dust a short physical
+        // translation cue when the phone itself is nudged.
+        float shiftBlend = 1f - (float) Math.exp(-7.0f * dt);
+        cameraShiftX += (targetShiftX - cameraShiftX) * shiftBlend;
+        cameraShiftY += (targetShiftY - cameraShiftY) * shiftBlend;
+        cameraShiftZ += (targetShiftZ - cameraShiftZ) * shiftBlend;
+        float shiftDecay = (float) Math.exp(-4.4f * dt);
+        targetShiftX *= shiftDecay;
+        targetShiftY *= shiftDecay;
+        targetShiftZ *= shiftDecay;
+        angularSpeed *= (float) Math.exp(-2.6f * dt);
+
+        float density = getResources().getDisplayMetrics().density;
+        float speedFov = Math.min(2.0f, angularSpeed * .65f);
+        float fovRad = (float) Math.toRadians(BASE_VERTICAL_FOV_DEG + speedFov);
+        float focal = (height * .5f) / (float) Math.tan(fovRad * .5f);
+        float centerX = width * .5f;
+        float centerY = height * .5f;
+
+        // A sub-pixel-scale observer sway creates a gentle near/mid/far depth cue even
+        // while the phone is still.  Because the same translation is applied in world
+        // units, nearby stars move naturally more than far stars under perspective.
+        float observerX = cameraShiftX + (float) Math.sin(time * .27f) * .018f;
+        float observerY = cameraShiftY + (float) Math.cos(time * .23f) * .013f;
+        float observerZ = cameraShiftZ + (float) Math.sin(time * .19f) * .009f;
+
+        for (Star s : stars) {
+            Starfield3DMath.rotateVector(cameraQ, s.x, s.y, s.z, rotated);
+            float x = rotated[0] - observerX;
+            float y = rotated[1] - observerY;
+            float z = rotated[2] - observerZ;
+
+            // Android device +Z points out of the screen, therefore the virtual camera
+            // looks along -Z into the star volume.
+            if (z >= -NEAR_PLANE) {
+                s.previousVisible = false;
+                continue;
+            }
+
+            float invDepth = 1f / -z;
+            float sx = centerX + x * focal * invDepth;
+            float sy = centerY - y * focal * invDepth;
+            if (sx < -48f || sx > width + 48f || sy < -48f || sy > height + 48f) {
+                s.previousVisible = false;
+                continue;
+            }
+
+            float facing = clamp((-z) / s.distance, 0f, 1f);
+            float twinkle = .83f + .17f * (float) Math.sin(time * s.twinkleSpeed + s.phase);
+            float radius = s.worldRadius * focal * invDepth;
+            radius = clamp(radius, .36f * density, 4.2f * density);
+            radius *= 1f + visualEnergy * .06f + visualBeat * .11f;
+
+            float layerAlpha = s.layer == LAYER_FAR ? .72f : s.layer == LAYER_MID ? .88f : 1f;
+            int alpha = (int) (255f * s.brightness * layerAlpha * twinkle * (.72f + facing * .28f));
+            alpha = Math.max(34, Math.min(255, alpha));
+
+            int neutralR = s.layer == LAYER_FAR ? 228 : 246;
+            int neutralG = s.layer == LAYER_FAR ? 238 : 248;
+            int neutralB = 255;
+            float tint = clamp(s.tintWeight + visualEnergy * .08f + visualBeat * .11f, .03f, .48f);
+            int r = mix(neutralR, Color.red(accent), tint);
+            int g = mix(neutralG, Color.green(accent), tint);
+            int b = mix(neutralB, Color.blue(accent), tint);
+
+            // Real screen-space displacement under fast camera rotation provides a tiny
+            // physically coherent streak instead of a synthetic warp-speed effect.
+            if (s.previousVisible && angularSpeed > .62f) {
+                float dx = sx - s.previousX;
+                float dy = sy - s.previousY;
+                float displacement = (float) Math.sqrt(dx * dx + dy * dy);
+                if (displacement > .8f && displacement < 34f * density) {
+                    float trail = clamp(.16f + (angularSpeed - .62f) * .10f, .16f, .38f);
+                    paint.setStrokeWidth(Math.max(.45f * density, radius * .52f));
+                    paint.setColor(Color.argb((int) (alpha * .22f), r, g, b));
+                    canvas.drawLine(sx - dx * trail, sy - dy * trail, sx, sy, paint);
+                }
+            }
+
+            if (s.layer != LAYER_FAR && (radius > 1.05f * density || s.flare)) {
+                float glow = radius * (s.layer == LAYER_NEAR ? 3.8f : 2.9f);
+                paint.setColor(Color.argb((int) (alpha * (s.layer == LAYER_NEAR ? .12f : .075f)), r, g, b));
+                canvas.drawCircle(sx, sy, glow, paint);
+            }
+
+            paint.setColor(Color.argb(alpha, r, g, b));
+            canvas.drawCircle(sx, sy, radius, paint);
+
+            if (s.flare && facing > .78f && radius > .85f * density) {
+                paint.setStrokeWidth(Math.max(.45f * density, radius * .22f));
+                paint.setColor(Color.argb((int) (alpha * .34f), r, g, b));
+                float arm = radius * (s.layer == LAYER_NEAR ? 3.6f : 2.8f);
+                canvas.drawLine(sx - arm, sy, sx + arm, sy, paint);
+                canvas.drawLine(sx, sy - arm, sx, sy + arm, paint);
+            }
+
+            s.previousX = sx;
+            s.previousY = sy;
+            s.previousVisible = true;
+        }
+
+        if (running) {
+            boolean active = angularSpeed > .035f
+                    || Math.abs(cameraShiftX) + Math.abs(cameraShiftY) + Math.abs(cameraShiftZ) > .012f
+                    || visualBeat > .045f || visualEnergy > .12f;
+            if (active) postInvalidateOnAnimation();
+            else postInvalidateDelayed(32L); // calm sky drops toward ~30 fps to reduce heat/battery.
+        }
+    }
+
+    private void updateAudio(float dt) {
+        float targetEnergy = 0f, targetBeat = 0f;
+        if (audioLevels != null) {
+            try {
+                targetEnergy = clamp(audioLevels.energy(), 0f, 1f);
+                targetBeat = clamp(audioLevels.beat(), 0f, 1f);
+            } catch (Exception ignored) { }
+        }
+        visualEnergy += (targetEnergy - visualEnergy) * (1f - (float) Math.exp(-5.0f * dt));
+        visualBeat += (targetBeat - visualBeat)
+                * (1f - (float) Math.exp(-(targetBeat > visualBeat ? 14f : 6.5f) * dt));
+    }
+
+    @Override public void onSensorChanged(SensorEvent event) {
+        if (event == null || event.sensor == null || event.values == null) return;
+        if (event.sensor == rotationSensor) {
+            updateRotation(event);
+        } else if (event.sensor == linearAccelerationSensor && event.values.length >= 3) {
+            // Device X right, Y up, Z out of screen.  Keep this deliberately tiny.
+            targetShiftX = clamp(-event.values[0] * .030f, -.18f, .18f);
+            targetShiftY = clamp(-event.values[1] * .026f, -.16f, .16f);
+            targetShiftZ = clamp(event.values[2] * .018f, -.10f, .10f);
+        }
+    }
+
+    private void updateRotation(SensorEvent event) {
+        if (event.values.length < 3) return;
+        try {
+            SensorManager.getQuaternionFromVector(sensorQ, event.values);
+            Starfield3DMath.normalize(sensorQ);
+            if (!hasBaseline) {
+                Starfield3DMath.copy(sensorQ, baselineSensorQ);
+                Starfield3DMath.identity(targetCameraQ);
+                Starfield3DMath.identity(cameraQ);
+                Starfield3DMath.copy(sensorQ, lastSensorQ);
+                hasBaseline = true;
+                hasLastSensorQ = true;
+                lastRotationSensorNs = event.timestamp;
+                clearTrails();
+                return;
+            }
+
+            Starfield3DMath.relativeCamera(baselineSensorQ, sensorQ, targetCameraQ);
+
+            if (hasLastSensorQ && lastRotationSensorNs > 0L && event.timestamp > lastRotationSensorNs) {
+                float seconds = (event.timestamp - lastRotationSensorNs) / 1_000_000_000f;
+                if (seconds > .0005f && seconds < .25f) {
+                    float instant = Starfield3DMath.angularDistance(lastSensorQ, sensorQ) / seconds;
+                    angularSpeed += (clamp(instant, 0f, 7f) - angularSpeed) * .32f;
+                }
+            }
+            Starfield3DMath.copy(sensorQ, lastSensorQ);
+            hasLastSensorQ = true;
+            lastRotationSensorNs = event.timestamp;
+        } catch (Exception ignored) { }
+    }
+
+    @Override public void onAccuracyChanged(Sensor sensor, int accuracy) { }
+
+    private static float lerp(float a, float b, float t) {
+        return a + (b - a) * t;
+    }
+
+    private static float clamp(float v, float lo, float hi) {
+        return Math.max(lo, Math.min(hi, v));
+    }
+
+    private static int mix(int a, int b, float t) {
+        return Math.max(0, Math.min(255, Math.round(a + (b - a) * t)));
+    }
