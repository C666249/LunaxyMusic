@@ -0,0 +1,48 @@
+package com.xingyu.music.model;
+
+import org.json.JSONObject;
+
+/** Metadata for one song downloaded by Lunaxy for offline playback. */
+public final class DownloadedTrack {
+    public final Song original;
+    public final String localUri;
+    public final String fileName;
+    public final long downloadedAt;
+
+    public DownloadedTrack(Song original, String localUri, String fileName, long downloadedAt) {
+        this.original = original;
+        this.localUri = localUri == null ? "" : localUri;
+        this.fileName = fileName == null ? "" : fileName;
+        this.downloadedAt = downloadedAt;
+    }
+
+    public String key() { return original == null ? "" : original.key(); }
+
+    /** Build a queue-safe Song whose provider points directly at the downloaded MediaStore/file URI. */
+    public Song asLocalSong() {
+        if (original == null) return new Song("local", localUri, "未知歌曲", "未知歌手", "", "", 0L);
+        return new Song("local", localUri, original.title, original.artist,
+                original.album, original.coverUrl, original.durationMs, true, true);
+    }
+
+    public JSONObject toJson() {
+        JSONObject o = new JSONObject();
+        try {
+            o.put("song", original == null ? JSONObject.NULL : original.toJson());
+            o.put("localUri", localUri);
+            o.put("fileName", fileName);
+            o.put("downloadedAt", downloadedAt);
+        } catch (Exception ignored) { }
+        return o;
+    }
+
+    public static DownloadedTrack fromJson(JSONObject o) {
+        if (o == null) return null;
+        JSONObject songJson = o.optJSONObject("song");
+        if (songJson == null) return null;
+        Song song = Song.fromJson(songJson);
+        String uri = o.optString("localUri", "");
+        if (uri.isEmpty()) return null;
+        return new DownloadedTrack(song, uri, o.optString("fileName", ""), o.optLong("downloadedAt", 0L));
+    }
+}
