+package com.xingyu.music.data;
+
+import android.content.Context;
+
+import com.xingyu.music.model.Song;
+import com.xingyu.music.model.SourceVariant;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Download-only resolver. It deliberately does NOT read/write SourceHealthStore,
+ * so downloading cannot teach, cool down, reorder, or otherwise perturb the proven playback chain.
+ */
+public final class DownloadSourceResolver {
+    public static final class Candidate {
+        public final String url;
+        public final boolean cached;
+        public final String quality;
+        public final String provider;
+        Candidate(String url, boolean cached, String quality, String provider) {
+            this.url = url; this.cached = cached; this.quality = quality; this.provider = provider;
+        }
+    }
+
+    private final PlaybackUrlStore cache;
+    private final Context context;
+    private LxSourceRuntime huibq;
+    private LxSourceRuntime qdy;
+
+    public DownloadSourceResolver(Context context) {
+        this.context = context.getApplicationContext();
+        this.cache = new PlaybackUrlStore(this.context);
+    }
+
+    /** Prefer URLs already proven by Media3; only resolve a new one if the song has no usable cache. */
+    public Candidate resolve(Song song, boolean allowCache) throws Exception {
+        if (song == null) throw new Exception("歌曲为空");
+        if (allowCache) {
+            Candidate stored = cached(song);
+            if (stored != null) return stored;
+        }
+        Exception last = null;
+        for (SourceVariant variant : song.variants()) {
+            for (String quality : qualities(variant)) {
+                for (String provider : providerOrder(variant.source)) {
+                    try {
+                        LxSourceRuntime runtime = runtime(provider);
+                        if (!runtime.supportsRoute(variant.source, quality)) continue;
+                        LxSourceRuntime.RuntimeResult result = runtime.musicUrl(variant, song, quality);
+                        if ("qdy".equals(provider)) {
+                            AudioUrlProbe.Result probe = AudioUrlProbe.check(result.url);
+                            if (probe.checked && !probe.playable) throw new Exception("全豆要下载地址失效：" + probe.reason);
+                        }
+                        return new Candidate(result.url, false, quality, provider);
+                    } catch (Exception e) {
+                        last = e;
+                    }
+                }
+            }
+        }
+        throw last == null ? new Exception("没有可下载的音频地址") : last;
+    }
+
+    private Candidate cached(Song song) {
+        for (SourceVariant variant : song.variants()) {
+            for (String quality : qualities(variant)) {
+                PlaybackUrlStore.Entry e = cache.get(variant.source, variant.sourceId, quality);
+                if (e != null && e.url != null && e.url.startsWith("http")) {
+                    return new Candidate(e.url, true, quality,
+                            e.providerLabel == null || e.providerLabel.isEmpty() ? "已验证缓存" : e.providerLabel);
+                }
+            }
+        }
+        return null;
+    }
+
+    private synchronized LxSourceRuntime runtime(String provider) {
+        if ("qdy".equals(provider)) {
+            if (qdy == null) qdy = new LxSourceRuntime(context, new ResolverProvider(
+                    "qdy", "全豆要聚合", "https://fastly.jsdelivr.net/gh/pdone/lx-music-source@main/qdy/latest.js", "", 1, true));
+            return qdy;
+        }
+        if (huibq == null) huibq = new LxSourceRuntime(context, new ResolverProvider(
+                "huibq", "Huibq", "", "source/huibq-latest.js", 1, false));
+        return huibq;
+    }
+
+    private static List<String> qualities(SourceVariant variant) {
+        List<String> q = new ArrayList<>();
+        if (variant.quality320) q.add("320k");
+        if (variant.quality128) q.add("128k");
+        if (q.isEmpty()) q.add("128k");
+        return q;
+    }
+
+    private static String[] providerOrder(String source) {
+        if ("tx".equals(source)) return new String[]{"huibq", "qdy"};
+        if ("wy".equals(source)) return new String[]{"qdy", "huibq"};
+        return new String[]{"huibq", "qdy"};
+    }
+
+    public synchronized void destroy() {
+        if (huibq != null) { huibq.destroy(); huibq = null; }
+        if (qdy != null) { qdy.destroy(); qdy = null; }
+    }
+}
