+package com.xingyu.music.data;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import com.xingyu.music.model.DownloadedTrack;
+import com.xingyu.music.model.Song;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Persistent index of Lunaxy-owned offline audio files. */
+public final class DownloadStore {
+    private final SharedPreferences prefs;
+
+    public DownloadStore(Context context) {
+        prefs = context.getSharedPreferences("lunaxy_offline_v1", Context.MODE_PRIVATE);
+    }
+
+    public synchronized List<DownloadedTrack> all() {
+        List<DownloadedTrack> out = new ArrayList<>();
+        try {
+            JSONArray a = new JSONArray(prefs.getString("tracks", "[]"));
+            for (int i = 0; i < a.length(); i++) {
+                DownloadedTrack item = DownloadedTrack.fromJson(a.optJSONObject(i));
+                if (item != null) out.add(item);
+            }
+        } catch (Exception ignored) { }
+        return out;
+    }
+
+    public synchronized boolean contains(Song song) {
+        if (song == null) return false;
+        String key = song.key();
+        for (DownloadedTrack item : all()) if (key.equals(item.key())) return true;
+        return false;
+    }
+
+    public synchronized DownloadedTrack find(Song song) {
+        if (song == null) return null;
+        String key = song.key();
+        for (DownloadedTrack item : all()) if (key.equals(item.key())) return item;
+        return null;
+    }
+
+    public synchronized List<DownloadedTrack> put(DownloadedTrack track) {
+        List<DownloadedTrack> out = new ArrayList<>();
+        if (track != null) out.add(track);
+        String key = track == null ? "" : track.key();
+        for (DownloadedTrack old : all()) {
+            if (!key.isEmpty() && key.equals(old.key())) continue;
+            out.add(old);
+        }
+        save(out);
+        return out;
+    }
+
+    public synchronized List<Song> localSongs() {
+        List<Song> out = new ArrayList<>();
+        for (DownloadedTrack item : all()) out.add(item.asLocalSong());
+        return out;
+    }
+
+    private void save(List<DownloadedTrack> tracks) {
+        JSONArray a = new JSONArray();
+        if (tracks != null) for (DownloadedTrack item : tracks) if (item != null) a.put(item.toJson());
+        prefs.edit().putString("tracks", a.toString()).apply();
+    }
+}
diff -ruN v32work/LunaxyMusic-V31/app/src/main/java/com/xingyu/music/data/OfflineDownloadManager.java v32build/LunaxyMusic-V32/app/src/main/java/com/xingyu/music/data/OfflineDownloadManager.java
--- v32work/LunaxyMusic-V31/app/src/main/java/com/xingyu/music/data/OfflineDownloadManager.java	1970-01-01 00:00:00.000000000 +0000
+++ v32build/LunaxyMusic-V32/app/src/main/java/com/xingyu/music/data/OfflineDownloadManager.java	2026-08-10 13:40:24.211352386 +0000
@@ -0,0 +1,218 @@
+package com.xingyu.music.data;
+
+import android.content.ContentResolver;
+import android.content.ContentValues;
+import android.content.Context;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Environment;
+import android.provider.MediaStore;
+
+import com.xingyu.music.model.DownloadedTrack;
+import com.xingyu.music.model.Song;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.Locale;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/** Small background downloader backed by MediaStore on Android 10+. */
+public final class OfflineDownloadManager {
+    public interface Listener {
+        void onComplete(DownloadedTrack track);
+        void onError(String message);
+    }
+
+    private final Context context;
+    private final DownloadStore store;
+    private final DownloadSourceResolver resolver;
+    private final ExecutorService worker = Executors.newFixedThreadPool(2);
+    private final Set<String> running = ConcurrentHashMap.newKeySet();
+
+    public OfflineDownloadManager(Context context, DownloadStore store) {
+        this.context = context.getApplicationContext();
+        this.store = store;
+        this.resolver = new DownloadSourceResolver(this.context);
+    }
+
+    public boolean isRunning(Song song) { return song != null && running.contains(song.key()); }
+
+    public void download(Song song, Listener listener) {
+        if (song == null) { fail(listener, "歌曲为空"); return; }
+        String key = song.key();
+        if (!running.add(key)) { fail(listener, "这首歌正在下载"); return; }
+        worker.submit(() -> {
+            try {
+                DownloadedTrack track = tryDownload(song, true);
+                store.put(track);
+                complete(listener, track);
+            } catch (Exception first) {
+                try {
+                    // A cached CDN URL may have expired. Fresh-resolve once, without changing playback health.
+                    DownloadedTrack track = tryDownload(song, false);
+                    store.put(track);
+                    complete(listener, track);
+                } catch (Exception second) {
+                    fail(listener, clean(second));
+                }
+            } finally {
+                running.remove(key);
+            }
+        });
+    }
+
+    private DownloadedTrack tryDownload(Song song, boolean allowCache) throws Exception {
+        DownloadSourceResolver.Candidate candidate = resolver.resolve(song, allowCache);
+        String ext = extension(candidate.url);
+        String fileName = sanitize(song.artist + " - " + song.title) + "." + ext;
+        Uri destination = createDestination(fileName, mime(ext), song);
+        boolean ok = false;
+        try {
+            copy(candidate.url, destination);
+            publish(destination);
+            ok = true;
+            return new DownloadedTrack(song, destination.toString(), fileName, System.currentTimeMillis());
+        } finally {
+            if (!ok) deleteQuietly(destination);
+        }
+    }
+
+    private Uri createDestination(String fileName, String mime, Song song) throws Exception {
+        if (Build.VERSION.SDK_INT >= 29) {
+            ContentValues values = new ContentValues();
+            values.put(MediaStore.MediaColumns.DISPLAY_NAME, fileName);
+            values.put(MediaStore.MediaColumns.MIME_TYPE, mime);
+            values.put(MediaStore.Audio.Media.TITLE, song.title);
+            values.put(MediaStore.Audio.Media.ARTIST, song.artist);
+            values.put(MediaStore.Audio.Media.ALBUM, song.album);
+            values.put(MediaStore.Audio.Media.IS_MUSIC, 1);
+            values.put(MediaStore.Audio.Media.IS_RINGTONE, 1);
+            values.put(MediaStore.MediaColumns.RELATIVE_PATH, Environment.DIRECTORY_MUSIC + "/Lunaxy Music");
+            values.put(MediaStore.MediaColumns.IS_PENDING, 1);
+            Uri uri = context.getContentResolver().insert(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, values);
+            if (uri == null) throw new Exception("无法创建本地音频文件");
+            return uri;
+        }
+        File root = context.getExternalFilesDir(Environment.DIRECTORY_MUSIC);
+        if (root == null) root = context.getFilesDir();
+        File dir = new File(root, "Lunaxy Music");
+        if (!dir.exists() && !dir.mkdirs()) throw new Exception("无法创建下载目录");
+        File file = uniqueFile(dir, fileName);
+        return Uri.fromFile(file);
+    }
+
+    private void copy(String url, Uri destination) throws Exception {
+        HttpURLConnection c = null;
+        try {
+            c = (HttpURLConnection) new URL(url).openConnection();
+            c.setConnectTimeout(15000);
+            c.setReadTimeout(30000);
+            c.setInstanceFollowRedirects(true);
+            c.setRequestProperty("User-Agent", "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 Chrome/124 Mobile Safari/537.36");
+            c.setRequestProperty("Accept", "audio/*,*/*;q=0.8");
+            int code = c.getResponseCode();
+            if (code < 200 || code >= 300) throw new Exception("下载失败：HTTP " + code);
+            ContentResolver cr = context.getContentResolver();
+            try (InputStream in = c.getInputStream(); OutputStream out = openOutput(cr, destination)) {
+                if (out == null) throw new Exception("无法写入下载文件");
+                byte[] buffer = new byte[64 * 1024];
+                long written = 0L;
+                int n;
+                while ((n = in.read(buffer)) >= 0) {
+                    if (n == 0) continue;
+                    out.write(buffer, 0, n);
+                    written += n;
+                    if (written > 512L * 1024L * 1024L) throw new Exception("音频文件异常过大，已停止下载");
+                }
+                out.flush();
+                if (written < 16 * 1024L) throw new Exception("下载到的音频文件过小，可能已失效");
+            }
+        } finally {
+            if (c != null) c.disconnect();
+        }
+    }
+
+    private OutputStream openOutput(ContentResolver cr, Uri uri) throws Exception {
+        if ("file".equalsIgnoreCase(uri.getScheme())) return new FileOutputStream(new File(uri.getPath()));
+        return cr.openOutputStream(uri, "w");
+    }
+
+    private void publish(Uri uri) {
+        if (Build.VERSION.SDK_INT < 29 || uri == null || !"content".equalsIgnoreCase(uri.getScheme())) return;
+        try {
+            ContentValues values = new ContentValues();
+            values.put(MediaStore.MediaColumns.IS_PENDING, 0);
+            context.getContentResolver().update(uri, values, null, null);
+        } catch (Exception ignored) { }
+    }
+
+    private void deleteQuietly(Uri uri) {
+        if (uri == null) return;
+        try {
+            if ("file".equalsIgnoreCase(uri.getScheme())) {
+                File f = new File(uri.getPath());
+                if (f.exists()) f.delete();
+            } else context.getContentResolver().delete(uri, null, null);
+        } catch (Exception ignored) { }
+    }
+
+    private static File uniqueFile(File dir, String name) {
+        File f = new File(dir, name);
+        if (!f.exists()) return f;
+        int dot = name.lastIndexOf('.');
+        String stem = dot > 0 ? name.substring(0, dot) : name;
+        String ext = dot > 0 ? name.substring(dot) : "";
+        for (int i = 2; i < 1000; i++) {
+            f = new File(dir, stem + " (" + i + ")" + ext);
+            if (!f.exists()) return f;
+        }
+        return new File(dir, System.currentTimeMillis() + ext);
+    }
+
+    private static String sanitize(String text) {
+        String s = text == null ? "Lunaxy Track" : text.trim();
+        s = s.replaceAll("[\\\\/:*?\"<>|\\r\\n]+", "_").replaceAll("\\s+", " ").trim();
+        if (s.isEmpty()) s = "Lunaxy Track";
+        return s.length() > 90 ? s.substring(0, 90).trim() : s;
+    }
+
+    private static String extension(String url) {
+        String lower = url == null ? "" : url.toLowerCase(Locale.ROOT);
+        int q = lower.indexOf('?'); if (q >= 0) lower = lower.substring(0, q);
+        for (String ext : new String[]{"flac", "m4a", "aac", "ogg", "wav", "mp3"}) if (lower.endsWith("." + ext)) return ext;
+        return "mp3";
+    }
+
+    private static String mime(String ext) {
+        if ("flac".equals(ext)) return "audio/flac";
+        if ("m4a".equals(ext)) return "audio/mp4";
+        if ("aac".equals(ext)) return "audio/aac";
+        if ("ogg".equals(ext)) return "audio/ogg";
+        if ("wav".equals(ext)) return "audio/wav";
+        return "audio/mpeg";
+    }
+
+    private static String clean(Exception e) {
+        String s = e == null || e.getMessage() == null ? "下载失败" : e.getMessage();
+        return s.length() > 130 ? s.substring(0, 130) + "…" : s;
+    }
+
+    private static void complete(Listener listener, DownloadedTrack track) {
+        if (listener != null) listener.onComplete(track);
+    }
+    private static void fail(Listener listener, String message) {
+        if (listener != null) listener.onError(message == null ? "下载失败" : message);
+    }
+
+    public void destroy() {
+        resolver.destroy();
+        worker.shutdownNow();
+    }
+}
