+    private static void placeStar(Star s, float dx, float dy, float dz, float distance) {
+        float n = (float) Math.sqrt(dx * dx + dy * dy + dz * dz);
+        if (n < 1.0e-6f) {
+            dx = 0f; dy = 0f; dz = -1f; n = 1f;
+        }
+        float inv = 1f / n;
+        dx *= inv; dy *= inv; dz *= inv;
+        s.distance = distance;
+        s.x = dx * distance;
+        s.y = dy * distance;
+        s.z = dz * distance;
+    }
