+    private static float smoothstep(float edge0, float edge1, float x) {
+        if (edge1 <= edge0) return x >= edge1 ? 1f : 0f;
+        float t = clamp((x - edge0) / (edge1 - edge0), 0f, 1f);
+        return t * t * (3f - 2f * t);
