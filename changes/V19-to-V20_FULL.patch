+package com.xingyu.music.data;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import com.xingyu.music.model.ImportedPlaylist;
+import com.xingyu.music.model.Song;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.Calendar;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Random;
+import java.util.Set;
+
+/**
+ * Free, local-first recommendation helper.
+ *
+ * It never resolves audio URLs. Daily discovery only performs the same metadata search
+ * already used by the Search tab; Private Radio is entirely local from favorites,
+ * playlists and recent history. Nothing here can change source health or playback caches.
+ */
+public final class RecommendationEngine {
+    private final NeteaseApi netease;
+    private final QQMusicApi qq;
+    private final SharedPreferences prefs;
+
+    public RecommendationEngine(Context context, NeteaseApi netease, QQMusicApi qq) {
+        this.netease = netease;
+        this.qq = qq;
+        prefs = context.getSharedPreferences("xingyu_recommend_v20", Context.MODE_PRIVATE);
+    }
+
+    public List<Song> daily(List<Song> favorites, List<ImportedPlaylist> playlists,
+                            List<Song> history, int limit) {
+        int max = Math.max(1, Math.min(limit, 30));
+        String day = dayKey();
+        if (day.equals(prefs.getString("daily_day", ""))) {
+            List<Song> cached = decode(prefs.getString("daily_songs", "[]"));
+            if (!cached.isEmpty()) return trim(cached, max);
+        }
+
+        List<String> seeds = topArtists(favorites, playlists, history, 2);
+        if (seeds.isEmpty()) return privateRadio(favorites, playlists, history, max);
+
+        Set<String> known = new HashSet<>();
+        addKeys(known, favorites);
+        addKeys(known, history);
+        if (playlists != null) for (ImportedPlaylist p : playlists) addKeys(known, p == null ? null : p.songs);
+
+        LinkedHashMap<String,Song> discovery = new LinkedHashMap<>();
+        for (String artist : seeds) {
+            List<Song> wy = new ArrayList<>();
+            List<Song> tx = new ArrayList<>();
+            try { wy = netease.search(artist, 18); } catch (Exception ignored) { }
+            try { tx = qq.search(artist, 18); } catch (Exception ignored) { }
+            List<Song> merged = SearchRanker.mergeAndRank(artist, wy, tx, 24);
+            for (Song s : merged) {
+                if (s == null || known.contains(s.key()) || !artistMatches(s.artist, artist)) continue;
+                discovery.putIfAbsent(s.key(), s);
+            }
+        }
+
+        List<Song> out = new ArrayList<>(discovery.values());
+        // Stable daily shuffle: same date gives the same list order on the same cache miss.
+        Collections.shuffle(out, new Random(day.hashCode() * 1103515245L + seeds.toString().hashCode()));
+        if (out.size() < Math.min(8, max)) {
+            for (Song s : privateRadio(favorites, playlists, history, max)) {
+                if (!containsKey(out, s.key())) out.add(s);
+                if (out.size() >= max) break;
+            }
+        }
+        out = trim(out, max);
+        if (!out.isEmpty()) {
+            prefs.edit().putString("daily_day", day).putString("daily_songs", encode(out)).apply();
+        }
+        return out;
+    }
+
+    public List<Song> privateRadio(List<Song> favorites, List<ImportedPlaylist> playlists,
+                                   List<Song> history, int limit) {
+        int max = Math.max(1, Math.min(limit, 40));
+        Map<String,Weighted> weighted = new LinkedHashMap<>();
+        addWeighted(weighted, favorites, 7);
+        if (playlists != null) for (ImportedPlaylist p : playlists) addWeighted(weighted, p == null ? null : p.songs, 3);
+        addWeighted(weighted, history, 1);
+        List<Weighted> all = new ArrayList<>(weighted.values());
+        Random random = new Random(System.nanoTime());
+        for (Weighted w : all) w.jitter = random.nextDouble() * 5.0;
+        all.sort((a,b) -> Double.compare((b.weight + b.jitter), (a.weight + a.jitter)));
+        List<Song> out = new ArrayList<>();
+        for (Weighted w : all) {
+            out.add(w.song);
+            if (out.size() >= max) break;
+        }
+        return out;
+    }
+
+    public boolean hasTaste(List<Song> favorites, List<ImportedPlaylist> playlists, List<Song> history) {
+        if (favorites != null && !favorites.isEmpty()) return true;
+        if (history != null && !history.isEmpty()) return true;
+        if (playlists != null) for (ImportedPlaylist p : playlists) if (p != null && !p.songs.isEmpty()) return true;
+        return false;
+    }
+
+    private static List<String> topArtists(List<Song> favorites, List<ImportedPlaylist> playlists,
+                                           List<Song> history, int limit) {
+        Map<String,Integer> score = new HashMap<>();
+        addArtistScore(score, favorites, 7);
+        if (playlists != null) for (ImportedPlaylist p : playlists) addArtistScore(score, p == null ? null : p.songs, 3);
+        addArtistScore(score, history, 1);
+        List<Map.Entry<String,Integer>> entries = new ArrayList<>(score.entrySet());
+        entries.sort((a,b) -> Integer.compare(b.getValue(), a.getValue()));
+        List<String> out = new ArrayList<>();
+        for (Map.Entry<String,Integer> e : entries) {
+            if (e.getKey().trim().isEmpty()) continue;
+            out.add(e.getKey());
+            if (out.size() >= limit) break;
+        }
+        return out;
+    }
+
+
+    private static boolean artistMatches(String songArtist, String seed) {
+        String a = normalize(songArtist);
+        String b = normalize(seed);
+        if (a.isEmpty() || b.isEmpty()) return false;
+        return a.contains(b) || b.contains(a);
+    }
+
+    private static String normalize(String value) {
+        return (value == null ? "" : value.toLowerCase(Locale.ROOT))
+                .replaceAll("[\\s\\p{Punct}，。！？：；、“”‘’《》【】（）()·]+", "");
+    }
+    private static void addArtistScore(Map<String,Integer> score, List<Song> songs, int weight) {
+        if (songs == null) return;
+        for (Song s : songs) {
+            if (s == null || s.artist == null) continue;
+            String[] names = s.artist.split("[/、&,，·]+");
+            for (String name : names) {
+                String clean = name == null ? "" : name.trim();
+                if (clean.isEmpty() || clean.length() > 36) continue;
+                score.put(clean, score.getOrDefault(clean, 0) + weight);
+            }
+        }
+    }
+
+    private static void addWeighted(Map<String,Weighted> out, List<Song> songs, int weight) {
+        if (songs == null) return;
+        for (Song s : songs) {
+            if (s == null) continue;
+            Weighted w = out.get(s.key());
+            if (w == null) out.put(s.key(), new Weighted(s, weight));
+            else w.weight += weight;
+        }
+    }
+
+    private static void addKeys(Set<String> out, List<Song> songs) {
+        if (songs == null) return;
+        for (Song s : songs) if (s != null) out.add(s.key());
+    }
+
+    private static boolean containsKey(List<Song> list, String key) {
+        if (list == null) return false;
+        for (Song s : list) if (s != null && s.key().equals(key)) return true;
+        return false;
+    }
+
+    private static String dayKey() {
+        Calendar c = Calendar.getInstance();
+        return String.format(Locale.US, "%04d-%02d-%02d", c.get(Calendar.YEAR), c.get(Calendar.MONTH) + 1, c.get(Calendar.DAY_OF_MONTH));
+    }
+
+    private static String encode(List<Song> songs) {
+        JSONArray a = new JSONArray();
+        if (songs != null) for (Song s : songs) if (s != null) a.put(s.toJson());
+        return a.toString();
+    }
+
+    private static List<Song> decode(String raw) {
+        List<Song> out = new ArrayList<>();
+        try {
+            JSONArray a = new JSONArray(raw == null ? "[]" : raw);
+            for (int i = 0; i < a.length(); i++) {
+                JSONObject o = a.optJSONObject(i);
+                if (o != null) out.add(Song.fromJson(o));
+            }
+        } catch (Exception ignored) { }
+        return out;
+    }
+
+    private static List<Song> trim(List<Song> source, int max) {
+        if (source == null || source.isEmpty()) return new ArrayList<>();
+        return source.size() <= max ? new ArrayList<>(source) : new ArrayList<>(source.subList(0, max));
+    }
+
+    private static final class Weighted {
+        final Song song;
+        int weight;
+        double jitter;
+        Weighted(Song song, int weight) { this.song = song; this.weight = weight; }
+    }
+}
